<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<ps:pagesnippets xmlns="http://www.w3.org/1999/xhtml" xmlns:ps="https://github.com/chzager/pagesnippets" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://github.com/chzager/pagesnippets https://chzager.github.io/pagesnippets/pagesnippets.xsd">
	<ps:stylesheet src="style.css" />
	<ps:script src="listlayout.js" />
	<ps:snippet-group name="layouts">
		<ps:snippet-group name="list">
			<ps:snippet name="main">
				<div class="desktop">
					<div name="warbandname" contenteditable="plaintext-only" data-blank="{{locales.blankWarbandName}}">
						<ps:event-handler on="blur" call="onWarbandNameBlur" />
						<ps:text>{{warband.name}}</ps:text>
					</div>
					<table>
						<colgroup>
							<col style="width:7%;" />
							<col style="width:27%;" />
							<col style="width:10%;" />
							<col style="width:10%;" />
							<col style="width:10%;" />
							<col style="width:36%;" />
							<col style="width:1.5em;" class="screen-only" />
						</colgroup>
						<thead>
							<tr class="unitsheader">
								<th>
									<ps:call-function name="getLocaleText">
										<ps:argument value="count" />
									</ps:call-function>
								</th>
								<th>
									<ps:call-function name="getLocaleText">
										<ps:argument value="name" />
									</ps:call-function>
								</th>
								<th class="center">{{locales.points}}</th>
								<th class="center">{{locales.quality}}</th>
								<th class="center">{{locales.combat}}</th>
								<th>{{locales.specialrules}}</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							<ps:for-each list="warband.units">
								<tr class="unit" data-id="{{id}}">
									<td class="ih">
										<input type="number" size="1" min="1" name="count" data-value="{{count}}" value="{{count}}">
											<ps:event-handler on="change" call="onUnitCountChanged" />
										</input>
									</td>
									<td class="ih">
										<span name="name" contenteditable="plaintext-only" data-blank="{{locales.blankUnitName}}" data-ispersonality="{{isPersonality}}">
											<ps:event-handler on="blur" call="onUnitNameBlur" />
											<ps:text>{{name}}</ps:text>
										</span>
									</td>
									<td class="center" name="points">
										<span>{{points}}</span>
									</td>
									<td class="ih center">
										<select name="quality" size="1" data-value="{{quality}}" value="{{quality}}">
											<ps:event-handler on="change" call="onQualityChanged" />
											<ps:for-each list="qualitySelectOptions">
												<option value="{{key}}">{{label}}</option>
											</ps:for-each>
										</select>
									</td>
									<td class="ih center">
										<select name="combat" size="1" data-value="{{combat}}" value="{{combat}}">
											<ps:event-handler on="change" call="onCombatChanged" />
											<ps:for-each list="combatSelectOptions">
												<option value="{{key}}">{{label}}</option>
											</ps:for-each>
										</select>
									</td>
									<td class="ih">
										<div class="specialrules">
											<ps:for-each list="specialrules">
												<span name="specialrule" data-key="{{key}}">
													<ps:call-function name="renderSpecialrule" />
												</span>
											</ps:for-each>
											<button class="specialruletrigger">
												<ps:event-handler on="click" call="editSpecialrules" />
												<ps:text>{{locales.editSpecialrules}}</ps:text>
											</button>
										</div>
									</td>
									<td class="ih">
										<i class="fa-solid fa-ellipsis-vertical unitmenu-icon screen-only">
											<ps:event-handler on="click" call="popupUnitMenu" />
										</i>
									</td>
								</tr>
							</ps:for-each>
							<tr class="buttons screen-only">
								<td colspan="999">
									<div class="buttons flex">
										<button>
											<ps:event-handler on="click" call="addUnit" />
											<ps:text>{{locales.addUnit}}</ps:text>
										</button>
										<ps:call-function name="getPasteUnitButton" />
									</div>
								</td>
							</tr>
							<ps:if test="{{pointpools.length}} &gt; 0">
								<ps:for-each list="pointpools">
									<tr data-pointspool="{{key}}">
										<td class="pointspool" colspan="2">{{label}}</td>
										<td class="ih">
											<span name="pointspool" data-key="{{key}}" data-blank="0" contenteditable="plaintext-only" data-type="number">
												<ps:event-handler on="blur" call="onPoolpointsBlur" />
												<ps:text>{{points}}</ps:text>
											</span>
										</td>
										<td colspan="9"></td>
									</tr>
								</ps:for-each>
							</ps:if>
						</tbody>
					</table>
				</div>
			</ps:snippet>
		</ps:snippet-group>
	</ps:snippet-group>
</ps:pagesnippets>
